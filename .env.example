APP_NAME="Messenger"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (Percona / MySQL-compatible) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=messenger
DB_USERNAME=messenger
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-db-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=messenger_cache

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --- Domain / TLS ---
# Real public domain (or subdomain) pointed at this server's IP.
# FrankenPHP/Caddy will automatically obtain a Let's Encrypt certificate for it.
APP_DOMAIN=localhost
# Set to false only for local testing without HTTPS (plain HTTP on HTTP_PORT).
# Always leave as true in production.
APP_HTTPS=true

# --- Octane (FrankenPHP) ---
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# --- Host ports (change only if 80/443 are already taken on this machine) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Broadcasting (Laravel Reverb — self-hosted WebSocket server) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=messenger
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Used by the PHP server (queue/app containers) to reach Reverb over the
# internal Docker network — do not change these.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Used by the BROWSER to reach Reverb through Caddy's /app/* proxy on the
# same public domain — this is what actually needs to match your deployment.
REVERB_CLIENT_HOST="${APP_DOMAIN}"
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https

# --- Browser push notifications (Web Push / VAPID) ---
# Generate a keypair with: docker compose run --rm app php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Operator account (seeded automatically on first boot) ---
OPERATOR_NAME=Operator
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=change-me-operator-password
